# ----------------------------------------------------------------------
# Worker Thread
# ----------------------------------------------------------------------
class HashWorker(QThread):
    """Background worker that hashes a list of files."""
    file_started = Signal(str)
    file_progress = Signal(int, int)
    file_result = Signal(str, str, str)  # path, md5, sha256
    file_error = Signal(str, str)
    finished = Signal(int, int)
    cancelled = Signal()

    def __init__(self, file_list: List[Path], compute_md5: bool, compute_sha256: bool):
        super().__init__()
        self.file_list = file_list
        self.compute_md5 = compute_md5
        self.compute_sha256 = compute_sha256
        self._is_cancelled = False
        self._mutex = QMutex()

    def cancel(self):
        with QMutexLocker(self._mutex):
            self._is_cancelled = True

    def _is_cancelled_safe(self) -> bool:
        with QMutexLocker(self._mutex):
            return self._is_cancelled

    def _hash_file(self, file_path: Path, algorithm: str) -> str:
        hash_func = hashlib.md5() if algorithm == 'md5' else hashlib.sha256()
        with open(file_path, 'rb') as f:
            for chunk in iter(lambda: f.read(HASH_BUFFER_SIZE), b''):
                if self._is_cancelled_safe():
                    raise InterruptedError("Cancelled")
                hash_func.update(chunk)
        return hash_func.hexdigest()

    def run(self):
        total = len(self.file_list)
        error_count = 0
        for idx, file_path in enumerate(self.file_list, start=1):
            if self._is_cancelled_safe():
                self.cancelled.emit()
                return
            self.file_progress.emit(idx, total)
            self.file_started.emit(str(file_path))
            md5_hash = ""
            sha256_hash = ""
            try:
                if self.compute_md5:
                    md5_hash = self._hash_file(file_path, 'md5').upper()
                if self.compute_sha256:
                    sha256_hash = self._hash_file(file_path, 'sha256').upper()
                self.file_result.emit(str(file_path), md5_hash, sha256_hash)
            except InterruptedError:
                self.cancelled.emit()
                return
            except Exception as e:
                error_count += 1
                self.file_error.emit(str(file_path), str(e))
                self.file_result.emit(str(file_path), "ERROR", "ERROR")
        self.finished.emit(total, error_count)


# ----------------------------------------------------------------------
# Custom File Row Widget
# ----------------------------------------------------------------------
class FileRowWidget(QWidget):
    """
    A single file row with expand/collapse, copy animations, and remove.
    """
    remove_requested = Signal(object)  # self
    copy_animation_done = Signal(object)  # self

    def __init__(self, file_path: Path, index: int, parent=None):
        super().__init__(parent)
        self.file_path = file_path
        self.index = index
        self.md5 = ""
        self.sha256 = ""
        self.is_expanded = True
        self.hashes_ready = False
        self._md5_copied = False
        self._sha256_copied = False
        self._init_ui()
        self._set_expanded_state(True)

    # ----- UI construction -----
    def _init_ui(self):
        self.setAutoFillBackground(True)
        self._base_palette = self.palette()
        self._base_palette.setColor(QPalette.Window, QColor(255, 255, 255))
        self._base_palette.setColor(QPalette.WindowText, QColor(33, 37, 41))
        self.setPalette(self._base_palette)

        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 6, 8, 6)
        layout.setSpacing(4)

        # ---- Top row (always visible) ----
        top_row = QHBoxLayout()
        top_row.setSpacing(8)

        self.num_label = QLabel(f"{self.index}.")
        self.num_label.setFixedWidth(35)
        self.num_label.setStyleSheet("font-weight: bold; color: #6c757d;")
        top_row.addWidget(self.num_label)

        self.icon_label = QLabel(self._get_file_icon())
        self.icon_label.setFixedWidth(30)
        top_row.addWidget(self.icon_label)

        # Filename – clickable for copy
        self.name_label = QLabel(self.file_path.name)
        self.name_label.setWordWrap(False)
        self.name_label.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        self.name_label.setCursor(Qt.PointingHandCursor)
        self.name_label.setToolTip("Click to copy filename")
        self.name_label.mousePressEvent = self._on_name_click
        top_row.addWidget(self.name_label)

        # Expand/collapse button
        self.toggle_btn = QPushButton("▲")
        self.toggle_btn.setFixedSize(28, 28)
        self.toggle_btn.setToolTip("Collapse")
        self.toggle_btn.clicked.connect(self._on_toggle)
        top_row.addWidget(self.toggle_btn)

        # Remove button
        self.remove_btn = QPushButton("✖")
        self.remove_btn.setFixedSize(28, 28)
        self.remove_btn.setToolTip("Remove from list")
        self.remove_btn.clicked.connect(lambda: self.remove_requested.emit(self))
        top_row.addWidget(self.remove_btn)

        layout.addLayout(top_row)

        # ---- Hash info (collapsible) ----
        self.hash_widget = QWidget()
        hash_layout = QVBoxLayout(self.hash_widget)
        hash_layout.setContentsMargins(45, 2, 0, 2)
        hash_layout.setSpacing(2)

        # MD5 row
        md5_row = QHBoxLayout()
        md5_row.setSpacing(6)
        md5_label = QLabel("MD5:")
        md5_label.setStyleSheet("font-weight: 600; color: #495057;")
        self.md5_value_label = QLabel("")
        self.md5_value_label.setWordWrap(True)
        self.md5_value_label.setCursor(Qt.PointingHandCursor)
        self.md5_value_label.setToolTip("Click to copy MD5")
        self.md5_value_label.mousePressEvent = lambda e: self._copy_hash("md5")
        self.md5_value_label.setStyleSheet("color: #0d6efd;")
        md5_row.addWidget(md5_label)
        md5_row.addWidget(self.md5_value_label, 1)
        hash_layout.addLayout(md5_row)

        # SHA256 row
        sha256_row = QHBoxLayout()
        sha256_row.setSpacing(6)
        sha256_label = QLabel("SHA256:")
        sha256_label.setStyleSheet("font-weight: 600; color: #495057;")
        self.sha256_value_label = QLabel("")
        self.sha256_value_label.setWordWrap(True)
        self.sha256_value_label.setCursor(Qt.PointingHandCursor)
        self.sha256_value_label.setToolTip("Click to copy SHA256")
        self.sha256_value_label.mousePressEvent = lambda e: self._copy_hash("sha256")
        self.sha256_value_label.setStyleSheet("color: #0d6efd;")
        sha256_row.addWidget(sha256_label)
        sha256_row.addWidget(self.sha256_value_label, 1)
        hash_layout.addLayout(sha256_row)

        layout.addWidget(self.hash_widget)

        # Install opacity effect for fade animations
        self._opacity_effect = QGraphicsOpacityEffect(self)
        self._opacity_effect.setOpacity(1.0)
        self.setGraphicsEffect(self._opacity_effect)

    def _get_file_icon(self) -> str:
        ext = self.file_path.suffix.lower()
        icons = {
            '.jpg': '🖼️', '.jpeg': '🖼️', '.png': '🖼️', '.gif': '🖼️', '.bmp': '🖼️',
            '.mp4': '🎬', '.mkv': '🎬', '.avi': '🎬', '.mov': '🎬',
            '.mp3': '🎵', '.wav': '🎵', '.flac': '🎵',
            '.pdf': '📄', '.doc': '📝', '.docx': '📝',
            '.zip': '📦', '.rar': '📦', '.7z': '📦', '.tar': '📦', '.gz': '📦',
            '.exe': '⚙️', '.msi': '⚙️',
            '.py': '💻', '.js': '💻', '.html': '💻', '.css': '💻', '.cpp': '💻', '.c': '💻'
        }
        return icons.get(ext, '📄')

    # ----- Public methods -----
    def set_hashes(self, md5: str, sha256: str):
        self.md5 = md5.upper() if md5 and md5 != "ERROR" else md5
        self.sha256 = sha256.upper() if sha256 and sha256 != "ERROR" else sha256
        self.hashes_ready = True
        self.md5_value_label.setText(self.md5 if self.md5 != "ERROR" else "ERROR")
        self.sha256_value_label.setText(self.sha256 if self.sha256 != "ERROR" else "ERROR")
        self._md5_copied = False
        self._sha256_copied = False

    # ----- Animation helpers -----
    def _animate_highlight(self, target, duration=500, color=QColor(180, 210, 255)):
        """Brief blue highlight on a widget."""
        original_style = target.styleSheet()
        target.setStyleSheet(f"background-color: {color.name()}; border-radius: 4px;")
        QTimer.singleShot(duration, lambda: target.setStyleSheet(original_style))

    def _animate_row_sweep(self):
        """Right-to-left sweep animation then collapse."""
        # Create a semi-transparent blue overlay effect
        anim = QPropertyAnimation(self._opacity_effect, b"opacity")
        anim.setDuration(2000)
        anim.setStartValue(1.0)
        anim.setEndValue(0.6)
        anim.setEasingCurve(QEasingCurve.InOutQuad)
        # Also animate a background color change via stylesheet
        self.setStyleSheet("background-color: #cce5ff;")
        anim.start()
        # When animation finishes, collapse the row
        anim.finished.connect(self._on_sweep_finished)

    def _on_sweep_finished(self):
        self.setStyleSheet("")
        self._opacity_effect.setOpacity(1.0)
        self._set_expanded_state(False)
        self.copy_animation_done.emit(self)

    # ----- Event handlers -----
    def _on_name_click(self, event):
        """Copy filename to clipboard and show highlight."""
        QApplication.clipboard().setText(self.file_path.name)
        self._animate_highlight(self.name_label)
        # Also show a tiny status message
        parent = self._find_main_window()
        if parent:
            parent.statusBar().showMessage(f"Copied: {self.file_path.name}", 1500)

    def _copy_hash(self, hash_type: str):
        """Copy a single hash and track if both have been copied."""
        if hash_type == "md5" and self.md5 and self.md5 != "ERROR":
            QApplication.clipboard().setText(self.md5)
            self._md5_copied = True
            self._animate_highlight(self.md5_value_label)
        elif hash_type == "sha256" and self.sha256 and self.sha256 != "ERROR":
            QApplication.clipboard().setText(self.sha256)
            self._sha256_copied = True
            self._animate_highlight(self.sha256_value_label)

        # If both copied, trigger sweep animation
        if self._md5_copied and self._sha256_copied:
            self._animate_row_sweep()

    def _on_toggle(self):
        self._set_expanded_state(not self.is_expanded)

    def _set_expanded_state(self, expanded: bool):
        self.is_expanded = expanded
        self.hash_widget.setVisible(expanded)
        if expanded:
            self.toggle_btn.setText("▲")
            self.toggle_btn.setToolTip("Collapse")
            self.setPalette(self._base_palette)
            self.name_label.setTextInteractionFlags(Qt.TextSelectableByMouse)
        else:
            self.toggle_btn.setText("▼")
            self.toggle_btn.setToolTip("Expand")
            gray_pal = QPalette(self._base_palette)
            gray_pal.setColor(QPalette.Window, QColor(245, 245, 245))
            gray_pal.setColor(QPalette.WindowText, QColor(180, 180, 180))
            self.setPalette(gray_pal)
            self.name_label.setTextInteractionFlags(Qt.NoTextInteraction)

    def _find_main_window(self):
        parent = self.parent()
        while parent and not isinstance(parent, QMainWindow):
            parent = parent.parent()
        return parent


