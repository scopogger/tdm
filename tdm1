    # ----- Logging (always buffers) -----
    def _log(self, message: str):
        """Append to buffer and update visible log if shown."""
        self._log_buffer.append(message)
        if self.live_log_toggle.isChecked():
            self.log_text.append(message)
            self.log_text.moveCursor(QTextCursor.End)

    # ----- File browsing -----
    def _browse_files(self):
        files, _ = QFileDialog.getOpenFileNames(
            self, "Select Files to Hash", "",
            "All Files (*.*)"
        )
        if files:
            added = sum(self._add_file(Path(f)) for f in files)
            self._refresh_list()
            self.statusBar().showMessage(f"Added {added} file(s)", 3000)

    def _browse_folder(self):
        folder = QFileDialog.getExistingDirectory(self, "Select Folder")
        if folder:
            added = self._add_folder(Path(folder))
            self._refresh_list()
            self.statusBar().showMessage(f"Added {added} file(s) from folder", 3000)

    # ----- Drag & drop -----
    def dragEnterEvent(self, event: QDragEnterEvent):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event: QDropEvent):
        urls = event.mimeData().urls()
        if not urls:
            return
        added_count = 0
        for url in urls:
            path = Path(url.toLocalFile())
            if path.exists():
                if path.is_file():
                    added_count += self._add_file(path)
                elif path.is_dir():
                    added_count += self._add_folder(path)
        if added_count > 0:
            self._refresh_list()
            self.statusBar().showMessage(f"Added {added_count} new file(s)", 3000)
        event.acceptProposedAction()

    # ----- File management -----
    def _add_file(self, file_path: Path) -> int:
        str_path = str(file_path.resolve())
        if str_path in self.file_rows:
            return 0
        self.file_paths.append(file_path)
        row = FileRowWidget(file_path, len(self.file_paths))
        row.remove_requested.connect(self._remove_row)
        row.copy_animation_done.connect(self._on_row_collapsed)
        self.file_rows[str_path] = row
        return 1

    def _add_folder(self, folder_path: Path) -> int:
        added = 0
        for file_path in folder_path.rglob("*"):
            if file_path.is_file():
                added += self._add_file(file_path)
        return added

    def _refresh_list(self):
        """Rebuild the list widget from file_rows."""
        self.file_list_widget.clear()
        for i, path in enumerate(self.file_paths):
            str_path = str(path.resolve())
            row = self.file_rows.get(str_path)
            if row:
                row.index = i + 1
                row.num_label.setText(f"{row.index}.")
                item = QListWidgetItem()
                self.file_list_widget.addItem(item)
                item.setSizeHint(row.sizeHint())
                self.file_list_widget.setItemWidget(item, row)
        self._update_start_button()

    def _remove_row(self, row_widget: FileRowWidget):
        path_str = str(row_widget.file_path.resolve())
        if path_str in self.file_rows:
            del self.file_rows[path_str]
        self.file_paths = [p for p in self.file_paths if str(p.resolve()) != path_str]
        self._refresh_list()
        self._update_start_button()
        self.statusBar().showMessage("File removed", 2000)

    def _on_row_collapsed(self, row_widget: FileRowWidget):
        """Called after the sweep animation finishes."""
        # Row is already collapsed; nothing else needed
        pass

    def _clear_all_files(self):
        self.file_list_widget.clear()
        self.file_rows.clear()
        self.file_paths.clear()
        self._log_buffer.clear()
        self.log_text.clear()
        self._update_start_button()
        self.statusBar().showMessage("Cleared all files")

    def _update_start_button(self):
        enabled = len(self.file_paths) > 0 and (self.compute_md5 or self.compute_sha256)
        self.start_btn.setEnabled(enabled)

    def _update_hash_options(self):
        self.compute_md5 = self.md5_cb.isChecked()
        self.compute_sha256 = self.sha256_cb.isChecked()
        self._update_start_button()

    def _toggle_live_log(self, checked):
        self.log_text.setVisible(checked)
        if checked:
            # Flush buffer to visible log
            self.log_text.clear()
            for line in self._log_buffer:
                self.log_text.append(line)
            self.log_text.moveCursor(QTextCursor.End)

    # ----- Hashing -----
    def _start_hashing(self):
        if not self.file_paths:
            return
        if not (self.compute_md5 or self.compute_sha256):
            QMessageBox.warning(self, "Warning", "Select at least one hash algorithm")
            return

        # Disable UI
        self.start_btn.setEnabled(False)
        self.cancel_btn.setEnabled(True)
        self.clear_all_btn.setEnabled(False)
        self.add_files_btn.setEnabled(False)
        self.add_folder_btn.setEnabled(False)
        self.md5_cb.setEnabled(False)
        self.sha256_cb.setEnabled(False)
        self.file_list_widget.setAcceptDrops(False)

        # Clear previous hashes
        for row in self.file_rows.values():
            row.set_hashes("", "")
            row.hashes_ready = False

        self.progress_bar.setValue(0)
        self.current_file_label.setText("Starting...")
        self._log("▶ Hashing started")

        self.worker = HashWorker(self.file_paths, self.compute_md5, self.compute_sha256)
        self.worker.file_started.connect(self._on_file_started)
        self.worker.file_progress.connect(self._on_progress)
        self.worker.file_result.connect(self._on_file_result)
        self.worker.file_error.connect(self._on_file_error)
        self.worker.finished.connect(self._on_finished)
        self.worker.cancelled.connect(self._on_cancelled)
        self.worker.start()

    def _cancel_hashing(self):
        if self.worker and self.worker.isRunning():
            self.worker.cancel()
            self.statusBar().showMessage("Cancelling...")

    def _on_file_started(self, path_str: str):
        for i in range(self.file_list_widget.count()):
            item = self.file_list_widget.item(i)
            widget = self.file_list_widget.itemWidget(item)
            if isinstance(widget, FileRowWidget) and str(widget.file_path.resolve()) == path_str:
                widget.setStyleSheet("background-color: #e0f0ff;")
            elif isinstance(widget, FileRowWidget):
                widget.setStyleSheet("")
        self.current_file_label.setText(f"Hashing: {Path(path_str).name}")

    def _on_progress(self, current: int, total: int):
        self.progress_bar.setMaximum(total)
        self.progress_bar.setValue(current)

    def _on_file_result(self, path_str: str, md5: str, sha256: str):
        row = self.file_rows.get(path_str)
        if row:
            row.set_hashes(md5, sha256)
        self._log(f"✅ {Path(path_str).name} - MD5: {md5}  SHA256: {sha256}")
        # Clear highlight
        for i in range(self.file_list_widget.count()):
            item = self.file_list_widget.item(i)
            widget = self.file_list_widget.itemWidget(item)
            if isinstance(widget, FileRowWidget) and str(widget.file_path.resolve()) == path_str:
                widget.setStyleSheet("")
                break

    def _on_file_error(self, path_str: str, error_msg: str):
        row = self.file_rows.get(path_str)
        if row:
            row.set_hashes("ERROR", "ERROR")
        self._log(f"❌ {Path(path_str).name}: {error_msg}")

    def _on_finished(self, total: int, error_count: int):
        self._reset_ui()
        msg = f"Hashing completed. Processed {total} files, errors: {error_count}."
        self._log(msg)
        self.statusBar().showMessage(msg)
        QMessageBox.information(self, "Complete", msg)

    def _on_cancelled(self):
        self._reset_ui()
        self._log("⚠️ Operation cancelled")
        self.statusBar().showMessage("Cancelled by user")

    def _reset_ui(self):
        self.cancel_btn.setEnabled(False)
        self.start_btn.setEnabled(True)
        self.clear_all_btn.setEnabled(True)
        self.add_files_btn.setEnabled(True)
        self.add_folder_btn.setEnabled(True)
        self.md5_cb.setEnabled(True)
        self.sha256_cb.setEnabled(True)
        self.file_list_widget.setAcceptDrops(True)
        self.current_file_label.setText("Ready")
        self.progress_bar.setValue(0)
        for i in range(self.file_list_widget.count()):
            item = self.file_list_widget.item(i)
            widget = self.file_list_widget.itemWidget(item)
            if isinstance(widget, FileRowWidget):
                widget.setStyleSheet("")


