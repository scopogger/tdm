# copy_feedback_demo.py
import sys
from pathlib import Path
from PySide6.QtCore import Qt, QTimer, Property, QPropertyAnimation
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QVBoxLayout, QWidget, QListWidget,
    QListWidgetItem, QLabel, QPushButton, QHBoxLayout, QFrame,
    QGraphicsOpacityEffect, QToolTip, QStatusBar
)
from PySide6.QtGui import QFont, QColor, QPalette

class FeedbackRow(QFrame):
    """
    A widget that demonstrates one copy‑feedback style.
    Click the large label to trigger the copy simulation.
    """
    def __init__(self, name, feedback_style, main_window):
        super().__init__()
        self.name = name
        self.feedback_style = feedback_style
        self.main_window = main_window
        self._full_text = f"sample_file_{name}.txt"
        self._copied = False
        self._flash_timer = None

        self.setStyleSheet("QFrame { background: white; border: 1px solid #ddd; border-radius: 4px; }")
        layout = QHBoxLayout(self)
        layout.setContentsMargins(10, 5, 10, 5)

        self.label = QLabel(self._full_text)
        self.label.setCursor(Qt.PointingHandCursor)
        self.label.setStyleSheet("font-size: 14px; padding: 5px; background: transparent;")
        self.label.mousePressEvent = lambda e: self._on_click()
        layout.addWidget(self.label, stretch=1)

        # small description
        desc = QLabel(feedback_style.replace('_', ' ').title())
        desc.setStyleSheet("font-size: 10px; color: #999; background: transparent;")
        layout.addWidget(desc, alignment=Qt.AlignRight)

    def _on_click(self):
        if self._copied:
            return
        self._copied = True
        # Simulate copying to clipboard (in real code you'd actually copy)
        print(f"Copied: {self._full_text}")

        # Execute feedback based on style
        if self.feedback_style == "flash_only":
            self._flash_label()
        elif self.feedback_style == "text_swap":
            self._text_swap("📋 Copied!")
        elif self.feedback_style == "status_bar":
            self._status_bar()
        elif self.feedback_style == "floating_tooltip":
            self._floating_tooltip()
        elif self.feedback_style == "checkmark_icon":
            self._checkmark_icon()
        elif self.feedback_style == "flash_and_swap":
            self._flash_label()
            self._text_swap("📋 Copied!")
        elif self.feedback_style == "all_combined":
            self._flash_label()
            self._text_swap("📋 Copied!")
            self._status_bar()

        # Reset after some time (except for status bar, which is permanent)
        QTimer.singleShot(1500, self._reset)

    def _flash_label(self):
        """Brief blue flash."""
        self.label.setStyleSheet(self.label.styleSheet() + " background-color: #c8d9ff; border-radius: 4px;")
        self._flash_timer = QTimer(self)
        self._flash_timer.setSingleShot(True)
        self._flash_timer.timeout.connect(lambda: self.label.setStyleSheet(
            self.label.styleSheet().replace("background-color: #c8d9ff;", "").replace("border-radius: 4px;", "")))
        self._flash_timer.start(750)

    def _text_swap(self, new_text):
        """Temporarily change the label text."""
        self.original_text = self.label.text()
        self.label.setText(new_text)
        # Revert after 1.5 s (same as reset)

    def _status_bar(self):
        """Show a message in the main window's status bar."""
        self.main_window.statusBar().showMessage(f"Copied: {self._full_text}", 3000)

    def _floating_tooltip(self):
        """Show a tooltip near the label that fades after 1.5 s."""
        # Create a label that acts as a tooltip
        tip = QLabel("Copied!", self)
        tip.setStyleSheet("background: #333; color: white; padding: 4px 8px; border-radius: 4px; font-size: 12px;")
        tip.setWindowFlags(Qt.ToolTip)
        tip.move(self.label.mapToGlobal(self.label.rect().topRight()))
        tip.show()
        QTimer.singleShot(1500, tip.deleteLater)

    def _checkmark_icon(self):
        """Append a green checkmark and fade it out."""
        self.check_label = QLabel("✓", self)
        self.check_label.setStyleSheet("color: green; font-size: 18px; font-weight: bold; background: transparent;")
        self.check_label.move(self.label.x() + self.label.width() + 5, self.label.y() + 2)
        self.check_label.show()
        # Fade out animation
        eff = QGraphicsOpacityEffect()
        self.check_label.setGraphicsEffect(eff)
        self.anim = QPropertyAnimation(eff, b"opacity")
        self.anim.setDuration(1000)
        self.anim.setStartValue(1.0)
        self.anim.setEndValue(0.0)
        self.anim.finished.connect(self.check_label.deleteLater)
        self.anim.start(QPropertyAnimation.DeleteWhenStopped)

    def _reset(self):
        """Restore label text and allow copy again."""
        if hasattr(self, 'original_text') and self.label.text() != self.original_text:
            self.label.setText(self.original_text)
        self._copied = False

class DemoWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Copy Feedback Demo – Click each row's filename")
        self.setMinimumSize(700, 500)

        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout(central)

        self.list_widget = QListWidget()
        layout.addWidget(self.list_widget)

        styles = [
            "flash_only",
            "text_swap",
            "status_bar",
            "floating_tooltip",
            "checkmark_icon",
            "flash_and_swap",
            "all_combined",
        ]
        for i, style in enumerate(styles):
            row = FeedbackRow(f"style_{i+1}", style, self)
            item = QListWidgetItem()
            self.list_widget.addItem(item)
            item.setSizeHint(row.sizeHint())
            self.list_widget.setItemWidget(item, row)

        self.statusBar().showMessage("Click a filename to see the feedback style. Hover for description.")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    window = DemoWindow()
    window.show()
    sys.exit(app.exec())