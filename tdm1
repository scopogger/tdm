# classes/native_file_dialog.py
import shutil
import subprocess
import sys
from urllib.parse import urlparse, unquote

from PySide6.QtWidgets import QFileDialog


class NativeFileDialog:
    """Drop-in replacement for QFileDialog.getSaveFileName/getOpenFileName.
    On Linux with kdialog available, uses it instead (same KIO widget Dolphin
    uses — real smb:// / sftp:// browsing). Falls back to the plain Qt dialog
    everywhere else, same pattern as EmailSender."""

    @staticmethod
    def _kdialog_available() -> bool:
        return sys.platform.startswith("linux") and shutil.which("kdialog") is not None

    @staticmethod
    def _url_to_path(raw: str) -> str:
        raw = raw.strip()
        parsed = urlparse(raw)
        if parsed.scheme in ("", "file"):
            return unquote(parsed.path) if parsed.scheme == "file" else raw
        return raw  # smb://, sftp:// etc — see note below

    @staticmethod
    def get_save_file_name(parent, caption: str, directory: str, filter: str):
        if NativeFileDialog._kdialog_available():
            try:
                result = subprocess.run(
                    ["kdialog", "--title", caption, "--getsaveurl", directory, filter],
                    capture_output=True, text=True
                )
                if result.returncode != 0:
                    return "", ""  # user cancelled
                if result.stdout.strip():
                    return NativeFileDialog._url_to_path(result.stdout.strip()), filter
            except Exception as e:
                print(f"[NativeFileDialog] kdialog save failed, falling back: {e}")
        return QFileDialog.getSaveFileName(parent, caption, directory, filter)

    @staticmethod
    def get_open_file_name(parent, caption: str, directory: str, filter: str):
        if NativeFileDialog._kdialog_available():
            try:
                result = subprocess.run(
                    ["kdialog", "--title", caption, "--getopenurl", directory, filter],
                    capture_output=True, text=True
                )
                if result.returncode != 0:
                    return "", ""
                if result.stdout.strip():
                    return NativeFileDialog._url_to_path(result.stdout.strip()), filter
            except Exception as e:
                print(f"[NativeFileDialog] kdialog open failed, falling back: {e}")
        return QFileDialog.getOpenFileName(parent, caption, directory, filter)