def open_file(self):
    pv = getattr(self.ui, 'pdfView', None)
    # Drawing mode: skip all dialogs, open in new instance
    if pv and getattr(pv, 'drawing_mode', False):
        last_dir = settings_manager.get_last_directory()
        file_path, _ = NativeFileDialog.get_open_file_name(
            self.main_window, "Open PDF", last_dir, "PDF Files (*.pdf)"
        )
        if not file_path:
            return
        settings_manager.save_last_directory(os.path.dirname(file_path))
        settings_manager.add_recent_file(file_path)
        self.update_recent_files_menu()
        self._launch_new_instance(file_path)
        return

    # Normal flow (drawing mode off)
    if getattr(self.main_window, 'is_document_modified', False):
        reply = self.main_window.ask_save_changes()
        if reply == QMessageBox.Cancel:
            return
        if reply == QMessageBox.Save and not self.save_file():
            return

    last_dir = settings_manager.get_last_directory()
    file_path, _ = NativeFileDialog.get_open_file_name(
        self.main_window, "Open PDF", last_dir, "PDF Files (*.pdf)"
    )
    if not file_path:
        return

    settings_manager.save_last_directory(os.path.dirname(file_path))
    settings_manager.add_recent_file(file_path)
    self.update_recent_files_menu()

    pv = getattr(self.ui, 'pdfView', None)
    has_open_doc = bool(pv and hasattr(pv, 'document') and pv.document is not None)
    if not has_open_doc:
        self.main_window.load_document(file_path)
        return

    choice = self._ask_open_window_choice()
    if choice == "same":
        self.main_window.load_document(file_path)
    elif choice == "new":
        self._launch_new_instance(file_path)





@staticmethod
def resolve_dropped_url(url) -> str:
    """Resolve a QUrl from a drag-and-drop event into a path fitz can open."""
    if url.isLocalFile():
        return url.toLocalFile()
    print(f"[NativeFileDialog] dropped URL isn't a local file: {url.toString()}")
    return ""





@staticmethod
def _url_is_pdf(url) -> bool:
    """toLocalFile() is empty for non-file:// URLs, so fall back to path()
    for the extension check — works for both local and remote URLs."""
    path = url.toLocalFile() or url.path()
    return path.lower().endswith('.pdf')

def dragEnterEvent(self, event: QDragEnterEvent):
    urls = event.mimeData().urls() if event.mimeData().hasUrls() else []
    if urls and self._url_is_pdf(urls[0]):
        event.accept()
    else:
        event.ignore()

def dropEvent(self, event: QDropEvent):
    urls = event.mimeData().urls()
    if not urls or not self._url_is_pdf(urls[0]):
        return

    file_path = NativeFileDialog.resolve_dropped_url(urls[0])
    if not file_path:
        QMessageBox.warning(
            self, "Не удалось открыть файл",
            "Не удалось получить доступ к перетащенному файлу.\nПопробуйте Файл → Открыть."
        )
        return

    if self.ui.pdfView.drawing_mode:
        self.actions_handler._launch_new_instance(file_path)
        return
    self.load_document(file_path)

