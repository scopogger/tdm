        self.setAcceptDrops(True)

    def _init_ui(self):
        self.setWindowTitle("HashKit - File Hash Calculator")
        self.setMinimumSize(960, 720)
        self.setStyleSheet(APP_STYLESHEET)

        central = QWidget()
        self.setCentralWidget(central)
        main_layout = QVBoxLayout(central)
        main_layout.setSpacing(12)
        main_layout.setContentsMargins(16, 16, 16, 16)

        # ---- File selection row ----
        sel_layout = QHBoxLayout()
        sel_layout.setSpacing(10)
        sel_label = QLabel("📂 Input Files:")
        sel_label.setStyleSheet("font-weight: bold;")
        sel_layout.addWidget(sel_label)

        self.add_files_btn = QPushButton("➕ Add Files")
        self.add_files_btn.setToolTip("Select one or more files to hash")
        self.add_files_btn.clicked.connect(self._browse_files)
        sel_layout.addWidget(self.add_files_btn)

        self.add_folder_btn = QPushButton("📁 Add Folder")
        self.add_folder_btn.setToolTip("Recursively add all files from a folder")
        self.add_folder_btn.clicked.connect(self._browse_folder)
        sel_layout.addWidget(self.add_folder_btn)

        sel_layout.addStretch()
        main_layout.addLayout(sel_layout)

        # ---- Options row ----
        opts_layout = QHBoxLayout()
        opts_layout.setSpacing(10)
        self.md5_cb = QCheckBox("MD5")
        self.md5_cb.setChecked(True)
        self.sha256_cb = QCheckBox("SHA256")
        self.sha256_cb.setChecked(True)
        self.md5_cb.toggled.connect(self._update_hash_options)
        self.sha256_cb.toggled.connect(self._update_hash_options)
        opts_layout.addWidget(self.md5_cb)
        opts_layout.addWidget(self.sha256_cb)

        opts_layout.addStretch()

        self.clear_all_btn = QPushButton("🗑 Clear All")
        self.clear_all_btn.clicked.connect(self._clear_all_files)
        opts_layout.addWidget(self.clear_all_btn)

        self.live_log_toggle = QCheckBox("Show Live Log")
        self.live_log_toggle.setChecked(False)
