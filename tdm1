import os
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import urlparse, unquote

from PySide6.QtWidgets import QFileDialog


class NativeFileDialog:
    """Drop-in replacement for QFileDialog.getSaveFileName/getOpenFileName.
    On Linux with a working kdialog, uses it (same KIO widget Dolphin uses).
    Falls back to the plain Qt dialog if kdialog is missing or broken."""

    _kdialog_ok = None
    _pending_remote_uploads: dict = {}  # temp local path -> real remote URL

    @staticmethod
    def _clean_env() -> dict:
        env = os.environ.copy()
        if sys.platform.startswith("linux"):
            if 'LD_LIBRARY_PATH_ORIG' in env:
                env['LD_LIBRARY_PATH'] = env['LD_LIBRARY_PATH_ORIG']
            else:
                env.pop('LD_LIBRARY_PATH', None)
        return env

    @staticmethod
    def _kdialog_available() -> bool:
        if not sys.platform.startswith("linux"):
            return False
        if NativeFileDialog._kdialog_ok is not None:
            return NativeFileDialog._kdialog_ok
        if shutil.which("kdialog") is None:
            NativeFileDialog._kdialog_ok = False
            return False
        try:
            result = subprocess.run(
                ["kdialog", "--version"], capture_output=True, text=True,
                timeout=5, env=NativeFileDialog._clean_env(),
            )
            NativeFileDialog._kdialog_ok = (result.returncode == 0)
        except Exception as e:
            print(f"[NativeFileDialog] kdialog self-test failed: {e}")
            NativeFileDialog._kdialog_ok = False
        return NativeFileDialog._kdialog_ok

    @staticmethod
    def _run_kdialog(args: list):
        try:
            result = subprocess.run(
                args, capture_output=True, text=True, env=NativeFileDialog._clean_env(),
            )
        except Exception as e:
            print(f"[NativeFileDialog] kdialog call failed: {e}")
            return None

        raw = result.stdout.strip()
        print(f"[NativeFileDialog] kdialog raw output: {raw!r} (exit {result.returncode})")

        if result.returncode == 0 and raw:
            return raw
        if result.returncode == 1 and not result.stderr.strip():
            return ""  # normal cancel
        print(f"[NativeFileDialog] kdialog exit {result.returncode}: {result.stderr.strip()}")
        return None

    @staticmethod
    def _resolve_save_target(raw_url: str) -> str:
        """Local file:// → ensure the parent directory exists (kdialog lets
        you type a path that isn't there yet). Genuine remote URL (smb://,
        sftp://...) → fitz can't write there directly, so stage a temp file
        and remember the real destination for finish_remote_save()."""
        parsed = urlparse(raw_url.strip())

        if parsed.scheme in ("", "file"):
            local_path = unquote(parsed.path) if parsed.scheme == "file" else raw_url
            parent = os.path.dirname(local_path)
            if parent and not os.path.isdir(parent):
                try:
                    os.makedirs(parent, exist_ok=True)
                except OSError as e:
                    print(f"[NativeFileDialog] could not create {parent}: {e}")
            return local_path

        suffix = os.path.splitext(parsed.path)[1] or ".pdf"
        fd, tmp_path = tempfile.mkstemp(suffix=suffix)
        os.close(fd)
        NativeFileDialog._pending_remote_uploads[tmp_path] = raw_url
        print(f"[NativeFileDialog] remote destination ({raw_url}) — staging at {tmp_path}")
        return tmp_path

    @staticmethod
    def finish_remote_save(local_path: str) -> bool:
        """Call after successfully writing to the path get_save_file_name()
        returned. No-op (True) unless that path was a staged remote upload."""
        remote_url = NativeFileDialog._pending_remote_uploads.pop(local_path, None)
        if remote_url is None:
            return True

        kioclient = (shutil.which("kioclient6") or shutil.which("kioclient5")
                     or shutil.which("kioclient"))
        if not kioclient:
            print("[NativeFileDialog] no kioclient found — can't upload to remote location")
            return False
        try:
            result = subprocess.run(
                [kioclient, "copy", local_path, remote_url],
                capture_output=True, text=True, env=NativeFileDialog._clean_env(),
            )
            if result.returncode != 0:
                print(f"[NativeFileDialog] kioclient copy failed ({result.returncode}): {result.stderr.strip()}")
                return False
            return True
        except Exception as e:
            print(f"[NativeFileDialog] kioclient copy exception: {e}")
            return False
        finally:
            try:
                os.remove(local_path)
            except OSError:
                pass

    @staticmethod
    def get_save_file_name(parent, caption: str, directory: str, filter: str):
        if NativeFileDialog._kdialog_available():
            raw = NativeFileDialog._run_kdialog(
                ["kdialog", "--title", caption, "--getsaveurl", directory, filter]
            )
            if raw is not None:
                return (NativeFileDialog._resolve_save_target(raw), filter) if raw else ("", "")
        return QFileDialog.getSaveFileName(parent, caption, directory, filter)

    @staticmethod
    def get_open_file_name(parent, caption: str, directory: str, filter: str):
        if NativeFileDialog._kdialog_available():
            raw = NativeFileDialog._run_kdialog(
                ["kdialog", "--title", caption, "--getopenurl", directory, filter]
            )
            if raw is not None:
                if not raw:
                    return "", ""
                parsed = urlparse(raw)
                return (unquote(parsed.path) if parsed.scheme == "file" else raw), filter
        return QFileDialog.getOpenFileName(parent, caption, directory, filter)
