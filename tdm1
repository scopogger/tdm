-- 1) TABLES — list, approx row count, comment
SELECT t.table_name,
       t.num_rows          AS approx_row_count,
       t.last_analyzed,
       c.comments          AS table_comment
FROM   all_tables t
LEFT JOIN all_tab_comments c
       ON c.owner = t.owner AND c.table_name = t.table_name
WHERE  t.owner = 'EXTRATN'
ORDER  BY t.table_name;

-- 2) COLUMNS — per table
SELECT tc.table_name,
       tc.column_id,
       tc.column_name,
       tc.data_type,
       tc.data_length,
       tc.data_precision,
       tc.data_scale,
       tc.nullable,
       tc.data_default,
       cc.comments AS column_comment
FROM   all_tab_columns tc
LEFT JOIN all_col_comments cc
       ON cc.owner = tc.owner AND cc.table_name = tc.table_name AND cc.column_name = tc.column_name
WHERE  tc.owner = 'EXTRATN'
ORDER  BY tc.table_name, tc.column_id;

-- 3) PRIMARY / UNIQUE KEYS
SELECT con.table_name,
       con.constraint_name,
       con.constraint_type,        -- P = primary key, U = unique
       LISTAGG(cc.column_name, ', ') WITHIN GROUP (ORDER BY cc.position) AS key_columns
FROM   all_constraints con
JOIN   all_cons_columns cc
       ON cc.owner = con.owner AND cc.constraint_name = con.constraint_name
WHERE  con.owner = 'EXTRATN'
AND    con.constraint_type IN ('P','U')
GROUP  BY con.table_name, con.constraint_name, con.constraint_type
ORDER  BY con.table_name, con.constraint_type;

-- 4) FOREIGN KEYS — child/parent relationships
SELECT a.table_name AS child_table,
       LISTAGG(ac.column_name, ', ') WITHIN GROUP (ORDER BY ac.position) AS child_columns,
       a.constraint_name,
       r.table_name AS parent_table,
       a.delete_rule,
       a.status
FROM   all_constraints a
JOIN   all_cons_columns ac
       ON ac.owner = a.owner AND ac.constraint_name = a.constraint_name
JOIN   all_constraints r
       ON r.owner = a.r_owner AND r.constraint_name = a.r_constraint_name
WHERE  a.owner = 'EXTRATN'
AND    a.constraint_type = 'R'
GROUP  BY a.table_name, a.constraint_name, r.table_name, a.delete_rule, a.status
ORDER  BY a.table_name;

-- 5) CHECK CONSTRAINTS — business rules baked into the schema
SELECT table_name, constraint_name, search_condition, status
FROM   all_constraints
WHERE  owner = 'EXTRATN'
AND    constraint_type = 'C'
AND    generated = 'USER NAME'
ORDER  BY table_name;

-- 6) INDEXES
SELECT i.table_name,
       i.index_name,
       i.uniqueness,
       LISTAGG(ic.column_name, ', ') WITHIN GROUP (ORDER BY ic.column_position) AS index_columns
FROM   all_indexes i
JOIN   all_ind_columns ic
       ON ic.index_owner = i.owner AND ic.index_name = i.index_name
WHERE  i.owner = 'EXTRATN'
GROUP  BY i.table_name, i.index_name, i.uniqueness
ORDER  BY i.table_name, i.index_name;

-- 7) VIEWS — definition text included
SELECT view_name, text
FROM   all_views
WHERE  owner = 'EXTRATN'
ORDER  BY view_name;

-- 8) PL/SQL OBJECT INVENTORY — watch STATUS = 'INVALID'
SELECT object_type, object_name, status, last_ddl_time
FROM   all_objects
WHERE  owner = 'EXTRATN'
AND    object_type IN ('PROCEDURE','FUNCTION','PACKAGE','PACKAGE BODY',
                        'TRIGGER','TYPE','TYPE BODY','SEQUENCE','SYNONYM',
                        'MATERIALIZED VIEW')
ORDER  BY object_type, object_name;

-- 9) FUNCTION / PROCEDURE SIGNATURES
SELECT package_name,
       object_name,
       overload,
       position,
       argument_name,
       data_type,
       in_out,
       defaulted
FROM   all_arguments
WHERE  owner = 'EXTRATN'
ORDER  BY NVL(package_name, object_name), object_name, overload, position;

-- 10) TRIGGERS
SELECT trigger_name, table_name, triggering_event, trigger_type, status
FROM   all_triggers
WHERE  owner = 'EXTRATN'
ORDER  BY table_name, trigger_name;

-- 11) SEQUENCES
SELECT sequence_name, min_value, max_value, increment_by, last_number
FROM   all_sequences
WHERE  sequence_owner = 'EXTRATN'
ORDER  BY sequence_name;

-- 12) SYNONYMS — no ALL_ version exists for this one (see note below)
SELECT synonym_name, table_owner, table_name, db_link
FROM   dba_synonyms
WHERE  owner = 'EXTRATN'
ORDER  BY synonym_name;
