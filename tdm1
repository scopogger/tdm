This also removes the zoom-reset side effect from a while back — worth specifically checking that scroll/zoom now stay put through a Save As, and that a plain Save right after still correctly targets the new path.

## Compress-to-server slowness — same bug as Save As, different call site

`compress_pdf()` never got the buffering treatment — Ghostscript writes straight to `-sOutputFile=<path>`, and if that path is a kio-fuse mount, it's the exact same slow-small-writes-through-FUSE problem, just from Ghostscript's side instead of fitz's. Folded into the rewrite below (GS always writes to a local temp file, then `NativeFileDialog.transfer_to()` moves it).

## Progress bar + real cancellation

This needed a bigger change: `subprocess.run()` blocks the whole app until Ghostscript exits, so there was never a chance for a Cancel click to do anything — which is exactly why closing the app didn't stop it either. Switching to `QProcess` (Qt's async process type) fixes both: it integrates with the event loop so a Cancel button actually works, and `.kill()` sends the signal immediately.

One thing I can't verify from here: the progress bar's page-by-page animation depends on Ghostscript printing `Page N` as it works (which needs dropping `-dQUIET`) — this is standard GS behavior, but if your build formats it differently, you'll still get a working, cancelable dialog, just without the bar filling in. Let me know what the console shows if it doesn't animate.

Add near the top of `actions_handler.py` (above `class ActionsHandler`):
```python
import re
from PySide6.QtCore import QProcess, QProcessEnvironment, QObject, Signal


class CompressWorker(QObject):
    progress = Signal(int, int)   # current page, total pages
    finished = Signal(bool, str)  # success, error message ("" if cancelled)

    def __init__(self, gs_path, input_path, tmp_output, quality_value, total_pages, parent=None):
        super().__init__(parent)
        self.total_pages = max(1, total_pages)
        self._stderr_tail = ""
        self._cancelled = False

        env = QProcessEnvironment.systemEnvironment()
        if sys.platform.startswith("linux"):
            orig = env.value("LD_LIBRARY_PATH_ORIG")
            if orig:
                env.insert("LD_LIBRARY_PATH", orig)
            else:
                env.remove("LD_LIBRARY_PATH")

        self.process = QProcess(self)
        self.process.setProcessEnvironment(env)
        self.process.setProgram(gs_path)
        self.process.setArguments([
            "-sDEVICE=pdfwrite",
            "-dCompatibilityLevel=1.4",
            f"-dPDFSETTINGS={quality_value}",
            "-dNOPAUSE",
            "-dBATCH",
            f"-sOutputFile={tmp_output}",
            input_path,
        ])
        self.process.readyReadStandardOutput.connect(self._on_output)
        self.process.readyReadStandardError.connect(self._on_output)
        self.process.finished.connect(self._on_finished)
        self.process.errorOccurred.connect(self._on_error)

    def start(self):
        self.process.start()

    def cancel(self):
        self._cancelled = True
        self.process.kill()

    def _on_output(self):
        data = (bytes(self.process.readAllStandardOutput()).decode(errors='replace') +
                bytes(self.process.readAllStandardError()).decode(errors='replace'))
        self._stderr_tail = (self._stderr_tail + data)[-2000:]
        for match in re.finditer(r'\bPage (\d+)\b', data):
            self.progress.emit(int(match.group(1)), self.total_pages)

    def _on_error(self, error):
        if not self._cancelled:
            self.finished.emit(False, f"Не удалось запустить Ghostscript: {error}")

    def _on_finished(self, exit_code, exit_status):
        if self._cancelled:
            self.finished.emit(False, "")  # empty message = don't show an error box
            return
        if exit_status == QProcess.ExitStatus.CrashExit:
            self.finished.emit(False, "Процесс сжатия был прерван.")
            return
        if exit_code != 0:
            self.finished.emit(False, self._stderr_tail.strip() or f"Ghostscript завершился с кодом {exit_code}")
            return
        self.finished.emit(True, "")
```

Replace `compress_pdf()` itself:
```python
def compress_pdf(self):
    gs_path = self.get_ghostscript_path()
    if not gs_path:
        QMessageBox.warning(self.main_window, "Ошибка сжатия", "Не найдена библиотека для сжатия файлов.")
        return

    current_path = getattr(self.main_window, 'current_document_path', '')
    if not current_path:
        QMessageBox.warning(self.main_window, "Нет документа", "Пожалуйста, сначала откройте PDF файл.")
        return

    if getattr(self.main_window, 'is_document_modified', False):
        clicked_button = self.save_message_box(
            "", "В документе есть несохраненные изменения. Требуется сохранить их перед сжатием."
        )
        if clicked_button == QMessageBox.RejectRole:
            return
        elif clicked_button == QMessageBox.YesRole:
            if not self.save_file():
                return

    default_dir = os.path.dirname(current_path)
    default_name = os.path.splitext(os.path.basename(current_path))[0] + "_compressed.pdf"
    default_path = os.path.join(default_dir, default_name)

    output_path, _ = NativeFileDialog.get_save_file_name(
        self.main_window, "Сохранить сжатый PDF файл как...", default_path, "PDF Files (*.pdf)"
    )
    if not output_path:
        return
    if not output_path.lower().endswith('.pdf'):
        output_path += '.pdf'

    if os.path.abspath(output_path) == os.path.abspath(current_path):
        reply = QMessageBox.question(
            self.main_window, "Перезапись файла",
            "Вы пытаетесь сохранить сжатый файл поверх исходного.\n"
            "Это приведёт к потере исходного файла. Вы уверены?",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.No
        )
        if reply != QMessageBox.Yes:
            return

    quality_options = {
        "Максимальное сжатие": "/screen",
        "Высокое": "/printer",
        "Среднее": "/ebook",
        "Слабое сжатие": "/prepress",
    }
    dialog = QInputDialog(self.main_window)
    dialog.setWindowTitle("Качество сжатия:")
    dialog.setLabelText("Выберите уровень сжатия:")
    dialog.setComboBoxItems(list(quality_options.keys()))
    dialog.setComboBoxEditable(False)
    dialog.setTextValue(list(quality_options)[2])
    dialog.setModal(True)
    dialog.setFixedSize(280, 130)
    if dialog.exec() == QInputDialog.DialogCode.Accepted:
        quality_value = quality_options[dialog.textValue()]
    else:
        return

    if not os.path.isfile(current_path):
        QMessageBox.critical(self.main_window, "Ошибка сжатия", f"Файл {current_path} не найден")
        return

    total_pages = 1
    try:
        _tmp_doc = fitz.open(current_path)
        total_pages = _tmp_doc.page_count
        _tmp_doc.close()
    except Exception:
        pass

    fd, tmp_output = tempfile.mkstemp(suffix=".pdf")
    os.close(fd)

    progress_dlg = QProgressDialog("Сжатие документа…", "Отмена", 0, total_pages, self.main_window)
    progress_dlg.setWindowModality(Qt.WindowModal)
    progress_dlg.setMinimumDuration(0)
    progress_dlg.setValue(0)

    worker = CompressWorker(gs_path, current_path, tmp_output, quality_value, total_pages, parent=self.main_window)
    self._compress_worker = worker  # keep alive until finished — don't let it get GC'd mid-run

    def _cleanup_tmp():
        try:
            os.remove(tmp_output)
        except OSError:
            pass

    def _on_progress(current, total):
        if total != progress_dlg.maximum():
            progress_dlg.setMaximum(total)
        progress_dlg.setValue(current)

    def _on_finished(success, error_message):
        progress_dlg.close()
        self._compress_worker = None

        if not success:
            _cleanup_tmp()
            if error_message:
                QMessageBox.critical(self.main_window, "Ошибка сжатия", f"При сжатии произошла ошибка: {error_message}")
            return

        try:
            if not os.path.isfile(tmp_output):
                QMessageBox.critical(self.main_window, "Ошибка сохранения", "Сжатие произвелось, но временный файл не создан.")
                return

            size_original = os.path.getsize(current_path) / 1024
            size_compressed = os.path.getsize(tmp_output) / 1024

            if size_compressed >= size_original:
                _cleanup_tmp()
                QMessageBox.information(
                    self.main_window, "",
                    "Оригинальный документ уже сжат до минимального объёма.\nНовая сжатая версия не будет создана."
                )
                return

            NativeFileDialog.transfer_to(tmp_output, output_path)
            compressed_ratio = (1 - size_compressed / size_original) * 100
            QMessageBox.information(
                self.main_window, "Сжатие завершено",
                f"Файл сохранён как: {output_path}\n\n"
                f"Размер исходного файла: {size_original:.1f} КБ\n"
                f"Размер сжатого файла: {size_compressed:.1f} КБ\n"
                f"Сжато на {compressed_ratio:.1f}%"
            )
        except Exception as e:
            QMessageBox.critical(self.main_window, "Ошибка сохранения", f"Не удалось сохранить сжатый файл: {e}")
        finally:
            _cleanup_tmp()

    worker.progress.connect(_on_progress)
    worker.finished.connect(_on_finished)
    progress_dlg.canceled.connect(worker.cancel)

    worker.start()
