@staticmethod
def is_remote_mount(path: str) -> bool:
    """True if *path* is a kio-fuse-mounted remote resource."""
    if path in NativeFileDialog._kiofuse_mounted_paths:
        return True
    return "/kio-fuse-" in path



@staticmethod
def buffered_save(save_fn, target_path: str) -> bool:
    import tempfile, time
    fd, tmp_path = tempfile.mkstemp(suffix=os.path.splitext(target_path)[1] or ".pdf")
    os.close(fd)
    try:
        print(f"[NativeFileDialog] buffered_save: writing locally, then copying to {target_path}")
        t0 = time.time()
        if not save_fn(tmp_path):
            return False
        t1 = time.time()
        shutil.copyfile(tmp_path, target_path)
        t2 = time.time()
        size_mb = os.path.getsize(tmp_path) / (1024 * 1024)
        print(f"[NativeFileDialog] buffered_save: {size_mb:.1f}MB — local write {t1-t0:.1f}s, copy to destination {t2-t1:.1f}s")
        return True
    except Exception as e:
        print(f"[NativeFileDialog] buffered save to {target_path} failed: {e}")
        return False
    finally:
        try:
            os.remove(tmp_path)
        except OSError:
            pass




def save_changes(self, file_path: str = None) -> bool:
    if not self.document:
        return True
    try:
        if file_path:
            save_path = file_path
        elif hasattr(self, '_original_doc_path') and self._original_doc_path:
            save_path = self._original_doc_path
        else:
            save_path = self.doc_path

        is_incremental = (save_path == self.doc_path)

        def _do_save(path: str) -> bool:
            try:
                self.document.save(path, is_incremental)
                return True
            except Exception as e:
                print(f"ERROR {e}")
                return False

        if not is_incremental and NativeFileDialog.is_remote_mount(save_path):
            return NativeFileDialog.buffered_save(_do_save, save_path)

        return _do_save(save_path)
    except Exception as e:
        QMessageBox.critical(None, "Save Error", f"Failed to save PDF: {e}")
        return False

