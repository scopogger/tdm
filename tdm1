**`pdf_viewer.py`** — add `insert_document`, mirroring `delete_pages_by_range`'s pattern exactly (mutate, then `reinitializePageWidgets` / `doc_changing` / `refresh_render`):
```python
def insert_document(self, new_doc, insert_before: bool, insert_at_page: int) -> bool:
    """Insert another fitz.Document's pages into the currently open document,
    in-memory — pending, exactly like rotate/delete/move page, until Save/Save As."""
    if not self.document or not self.document.current_doc:
        return False
    try:
        total = self.document.current_doc.page_count
        start_at = insert_at_page if insert_before else insert_at_page + 1
        if start_at >= total:
            start_at = -1  # append at end

        self.document.insert_pdf(new_doc, start_at=start_at)

        self.page_cache.clear()
        self.reinitializePageWidgets()
        self.doc_changing()
        self.refresh_render()
        return True
    except Exception as e:
        print(f"[PDFViewer] insert_document error: {e}")
        return False
```

**`file_inserting.py`** — `_do_merge_flow` shrinks a lot; `_merging()` is now dead code, safe to delete:
```python
def _do_merge_flow(self, source_path: str):
    self.cur_doc     = self.pv.document.current_doc
    current_page     = self.pv.get_current_page()

    dialog = InsertPageDialogue(
        self.main_window,
        max_pages=self.cur_doc.page_count,
        current_page=current_page
    )
    if dialog.exec() != QDialog.Accepted:
        self.new_doc.close()
        return

    location, target, page_num = dialog.get_insertion_settings()
    insert_before = (location == "before")

    if target == "first":
        insert_at_page = 0
    elif target == "last":
        insert_at_page = self.cur_doc.page_count - 1
    else:
        insert_at_page = page_num - 1

    success = self.pv.insert_document(self.new_doc, insert_before, insert_at_page)
    self.new_doc.close()

    if success:
        if hasattr(self.ui, 'thumbnailList'):
            try:
                self.ui.thumbnailList.refresh_thumbnails(self.pv.document)
            except Exception as e:
                print(f"Thumbnail update failed: {e}")
        self.main_window.update_ui_state()
        self.main_window.update_page_info()
        QMessageBox.information(self.main_window, "Успех",
                                "Файл успешно вставлен! Не забудьте сохранить документ.")
    else:
        QMessageBox.critical(self.main_window, "Ошибка",
                             "Не удалось вставить файл в документ.")
```

