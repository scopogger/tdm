#!/usr/bin/env python3
"""
HashKit - File Hash Calculator with Modern UI
Supports drag & drop, expandable file rows, MD5/SHA256 hashing, and live log.
"""

import hashlib
import sys
import os
from pathlib import Path
from typing import Optional, List, Dict, Set
from datetime import datetime

from PySide6.QtCore import QThread, Signal, Qt, QMutex, QMutexLocker
from PySide6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QPushButton, QLabel, QLineEdit, QProgressBar, QTextEdit,
    QCheckBox, QFileDialog, QMessageBox, QGroupBox, QListWidget,
    QListWidgetItem, QScrollArea, QFrame, QSizePolicy, QAbstractItemView
)
from PySide6.QtGui import (
    QFont, QTextCursor, QDragEnterEvent, QDropEvent, QClipboard,
    QFontDatabase, QColor, QPalette
)

# Configuration
HASH_BUFFER_SIZE = 4 * 1024 * 1024  # 4 MB buffer


class HashWorker(QThread):
    """Background worker that hashes a list of files."""
    # Signals
    file_started = Signal(str)           # file path (when processing begins)
    file_progress = Signal(int, int)      # current index, total count
    file_result = Signal(str, str, str)   # file_path, md5 (or empty), sha256 (or empty)
    file_error = Signal(str, str)         # file_path, error message
    finished = Signal(int, int)           # total files, error count
    cancelled = Signal()

    def __init__(self, file_list: List[Path], compute_md5: bool, compute_sha256: bool):
        super().__init__()
        self.file_list = file_list
        self.compute_md5 = compute_md5
        self.compute_sha256 = compute_sha256
        self._is_cancelled = False
        self._mutex = QMutex()

    def cancel(self):
        with QMutexLocker(self._mutex):
            self._is_cancelled = True

    def _is_cancelled_safe(self) -> bool:
        with QMutexLocker(self._mutex):
            return self._is_cancelled

    def _hash_file(self, file_path: Path, algorithm: str) -> str:
        """Hash a single file with chunked reading."""
        hash_func = hashlib.md5() if algorithm == 'md5' else hashlib.sha256()
        with open(file_path, 'rb') as f:
            for chunk in iter(lambda: f.read(HASH_BUFFER_SIZE), b''):
                if self._is_cancelled_safe():
                    raise InterruptedError("Cancelled")
                hash_func.update(chunk)
        return hash_func.hexdigest()

    def run(self):
        total = len(self.file_list)
        error_count = 0

        for idx, file_path in enumerate(self.file_list, start=1):
            if self._is_cancelled_safe():
                self.cancelled.emit()
                return

            self.file_progress.emit(idx, total)
            self.file_started.emit(str(file_path))

            md5_hash = ""
            sha256_hash = ""

            try:
                if self.compute_md5:
                    md5_hash = self._hash_file(file_path, 'md5').upper()
                if self.compute_sha256:
                    sha256_hash = self._hash_file(file_path, 'sha256').upper()
                self.file_result.emit(str(file_path), md5_hash, sha256_hash)
            except InterruptedError:
                self.cancelled.emit()
                return
            except Exception as e:
                error_count += 1
                self.file_error.emit(str(file_path), str(e))
                # Still emit result with error placeholders
                self.file_result.emit(str(file_path), "ERROR", "ERROR")

        self.finished.emit(total, error_count)


class FileRowWidget(QWidget):
    """Custom widget for each file in the list: expandable, shows hashes, copy button."""
    copy_requested = Signal(str, str, str)   # file_path, md5, sha256
    remove_requested = Signal(object)        # self (the row widget)

    def __init__(self, file_path: Path, index: int, parent=None):
        super().__init__(parent)
        self.file_path = file_path
        self.index = index
        self.md5 = ""
        self.sha256 = ""
        self.is_expanded = True
        self.hashes_ready = False

        self._init_ui()
        self._set_expanded_state(True)

    def _init_ui(self):
        layout = QVBoxLayout(self)
        layout.setContentsMargins(5, 5, 5, 5)
        layout.setSpacing(3)

        # Top row: number, icon, name, buttons
        top_row = QHBoxLayout()
        top_row.setSpacing(10)

        # File number
        self.num_label = QLabel(f"{self.index}.")
        self.num_label.setFixedWidth(35)
        top_row.addWidget(self.num_label)

        # Icon label (using emoji for simplicity; could use font icons)
        self.icon_label = QLabel(self._get_file_icon())
        self.icon_label.setFixedWidth(30)
        top_row.addWidget(self.icon_label)

        # File name (no path)
        self.name_label = QLabel(self.file_path.name)
        self.name_label.setWordWrap(False)
        self.name_label.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Preferred)
        top_row.addWidget(self.name_label)

        # Copy button (only visible when expanded and hashes ready)
        self.copy_btn = QPushButton("📋")
        self.copy_btn.setFixedSize(30, 30)
        self.copy_btn.setToolTip("Copy MD5 and SHA256")
        self.copy_btn.clicked.connect(self._on_copy)
        top_row.addWidget(self.copy_btn)

        # Expand/collapse button
        self.toggle_btn = QPushButton("▲")
        self.toggle_btn.setFixedSize(30, 30)
        self.toggle_btn.setToolTip("Collapse")
        self.toggle_btn.clicked.connect(self._on_toggle)
        top_row.addWidget(self.toggle_btn)

        # Remove button
        self.remove_btn = QPushButton("✖")
        self.remove_btn.setFixedSize(30, 30)
        self.remove_btn.setToolTip("Remove from list")
        self.remove_btn.clicked.connect(lambda: self.remove_requested.emit(self))
        top_row.addWidget(self.remove_btn)

        layout.addLayout(top_row)

        # Bottom row (hash info, visible only when expanded)
        self.hash_widget = QWidget()
        hash_layout = QHBoxLayout(self.hash_widget)
        hash_layout.setContentsMargins(35, 0, 0, 0)  # indent
        self.md5_label = QLabel("MD5: ")
        self.sha256_label = QLabel("SHA256: ")
        hash_layout.addWidget(self.md5_label)
        hash_layout.addWidget(self.sha256_label)
        hash_layout.addStretch()
        layout.addWidget(self.hash_widget)

        self.setAutoFillBackground(True)

    def _get_file_icon(self) -> str:
        """Return an emoji icon based on file extension."""
        ext = self.file_path.suffix.lower()
        if ext in ['.jpg', '.jpeg', '.png', '.gif', '.bmp']:
            return "🖼️"
        elif ext in ['.mp4', '.mkv', '.avi', '.mov']:
            return "🎬"
        elif ext in ['.mp3', '.wav', '.flac']:
            return "🎵"
        elif ext in ['.pdf']:
            return "📄"
        elif ext in ['.doc', '.docx']:
            return "📝"
        elif ext in ['.zip', '.rar', '.7z', '.tar', '.gz']:
            return "🗜️"
        elif ext in ['.exe', '.msi']:
            return "⚙️"
        elif ext in ['.py', '.js', '.html', '.css', '.cpp', '.c']:
            return "💻"
        else:
            return "📁"

    def set_hashes(self, md5: str, sha256: str):
        self.md5 = md5.upper() if md5 and md5 != "ERROR" else md5
        self.sha256 = sha256.upper() if sha256 and sha256 != "ERROR" else sha256
        self.hashes_ready = True
        self.md5_label.setText(f"MD5: {self.md5}")
        self.sha256_label.setText(f"SHA256: {self.sha256}")
        # Enable copy button only if expanded and hashes are valid (not ERROR)
        if self.is_expanded and self.md5 != "ERROR" and self.sha256 != "ERROR":
            self.copy_btn.setEnabled(True)
        else:
            self.copy_btn.setEnabled(False)

    def _on_copy(self):
        if not self.hashes_ready or not self.is_expanded:
            return
        # Copy both hashes to clipboard
        clipboard = QApplication.clipboard()
        text = f"MD5: {self.md5}\nSHA256: {self.sha256}"
        clipboard.setText(text)
        # Auto-collapse after copy
        self._set_expanded_state(False)
        # Emit a signal to notify parent? Not needed, but can show status
        parent = self.parent()
        while parent and not isinstance(parent, QMainWindow):
            parent = parent.parent()
        if parent:
            parent.statusBar().showMessage("Hashes copied, row collapsed", 2000)

    def _on_toggle(self):
        self._set_expanded_state(not self.is_expanded)

    def _set_expanded_state(self, expanded: bool):
        self.is_expanded = expanded
        self.hash_widget.setVisible(expanded)
        if expanded:
            self.toggle_btn.setText("▲")
            self.toggle_btn.setToolTip("Collapse")
            # Restore normal appearance
            pal = self.palette()
            pal.setColor(QPalette.Window, QColor(255, 255, 255))
            self.setPalette(pal)
            self.name_label.setTextInteractionFlags(Qt.TextSelectableByMouse)
            # Show copy button only if hashes are ready and not errors
            if self.hashes_ready and self.md5 != "ERROR" and self.sha256 != "ERROR":
                self.copy_btn.setVisible(True)
                self.copy_btn.setEnabled(True)
            else:
                self.copy_btn.setVisible(False)
        else:
            self.toggle_btn.setText("▼")
            self.toggle_btn.setToolTip("Expand")
            # Gray out and disable text selection
            pal = self.palette()
            gray_color = QColor(180, 180, 180)
            pal.setColor(QPalette.Window, QColor(240, 240, 240))
            pal.setColor(QPalette.WindowText, gray_color)
            self.setPalette(pal)
            self.num_label.setPalette(pal)
            self.icon_label.setPalette(pal)
            self.name_label.setPalette(pal)
            self.name_label.setTextInteractionFlags(Qt.NoTextInteraction)
            self.copy_btn.setVisible(False)


class HashKitWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.worker: Optional[HashWorker] = None
        self.file_rows: Dict[str, FileRowWidget] = {}  # path -> row widget
        self.file_paths: List[Path] = []               # ordered list
        self.output_path: Optional[Path] = None
        self.compute_md5 = True
        self.compute_sha256 = True
        self._init_ui()
        self.setAcceptDrops(True)

    def _init_ui(self):
        self.setWindowTitle("HashKit - File Hash Calculator")
        self.setMinimumSize(900, 700)

        central = QWidget()
        self.setCentralWidget(central)
        main_layout = QVBoxLayout(central)

        # Output file selection row
        out_layout = QHBoxLayout()
        out_layout.addWidget(QLabel("Save results:"))
        self.output_line = QLineEdit()
        self.output_line.setReadOnly(True)
        self.output_line.setPlaceholderText("Select output file...")
        out_layout.addWidget(self.output_line)
        self.browse_out_btn = QPushButton("Browse")
        self.browse_out_btn.clicked.connect(self._browse_output)
        out_layout.addWidget(self.browse_out_btn)
        main_layout.addLayout(out_layout)

        # Options row: MD5/SHA256 toggles, Clear All, Show Live Log
        opts_layout = QHBoxLayout()
        self.md5_cb = QCheckBox("MD5")
        self.md5_cb.setChecked(True)
        self.sha256_cb = QCheckBox("SHA256")
        self.sha256_cb.setChecked(True)
        self.md5_cb.toggled.connect(self._update_hash_options)
        self.sha256_cb.toggled.connect(self._update_hash_options)
        self.clear_all_btn = QPushButton("Clear All")
        self.clear_all_btn.clicked.connect(self._clear_all_files)
        self.live_log_toggle = QCheckBox("Show Live Log")
        self.live_log_toggle.setChecked(False)
        self.live_log_toggle.toggled.connect(self._toggle_live_log)
        opts_layout.addWidget(self.md5_cb)
        opts_layout.addWidget(self.sha256_cb)
        opts_layout.addStretch()
        opts_layout.addWidget(self.clear_all_btn)
        opts_layout.addWidget(self.live_log_toggle)
        main_layout.addLayout(opts_layout)

        # File list (scrollable)
        self.file_list_widget = QListWidget()
        self.file_list_widget.setDragEnabled(False)
        self.file_list_widget.setAcceptDrops(True)
        self.file_list_widget.setSelectionMode(QAbstractItemView.ExtendedSelection)
        self.file_list_widget.setDropIndicatorShown(True)
        self.file_list_widget.viewport().setAcceptDrops(True)
        self.file_list_widget.setDragDropMode(QAbstractItemView.InternalMove)  # not used
        main_layout.addWidget(QLabel("Files to process (drag & drop files/folders here):"))
        main_layout.addWidget(self.file_list_widget)

        # Live log (initially hidden)
        self.log_text = QTextEdit()
        self.log_text.setReadOnly(True)
        self.log_text.setFont(QFont("Consolas", 9))
        self.log_text.setVisible(False)
        main_layout.addWidget(self.log_text)

        # Progress area
        progress_group = QGroupBox("Progress")
        prog_layout = QVBoxLayout()
        self.progress_bar = QProgressBar()
        self.current_file_label = QLabel("Ready")
        self.current_file_label.setWordWrap(True)
        prog_layout.addWidget(self.progress_bar)
        prog_layout.addWidget(self.current_file_label)
        progress_group.setLayout(prog_layout)
        main_layout.addWidget(progress_group)

        # Start / Cancel buttons
        btn_layout = QHBoxLayout()
        self.start_btn = QPushButton("Start Hashing")
        self.start_btn.clicked.connect(self._start_hashing)
        self.start_btn.setEnabled(False)
        self.cancel_btn = QPushButton("Cancel")
        self.cancel_btn.clicked.connect(self._cancel_hashing)
        self.cancel_btn.setEnabled(False)
        btn_layout.addWidget(self.start_btn)
        btn_layout.addWidget(self.cancel_btn)
        btn_layout.addStretch()
        main_layout.addLayout(btn_layout)

        self.statusBar().showMessage("Drag and drop files/folders or select output file first")

    def _browse_output(self):
        path, _ = QFileDialog.getSaveFileName(self, "Save Results As", "", "Text Files (*.txt)")
        if path:
            self.output_path = Path(path)
            self.output_line.setText(str(self.output_path))
            self._update_start_button()

    def _update_hash_options(self):
        self.compute_md5 = self.md5_cb.isChecked()
        self.compute_sha256 = self.sha256_cb.isChecked()
        self._update_start_button()

    def _update_start_button(self):
        enabled = (len(self.file_paths) > 0 and self.output_path is not None and
                   (self.compute_md5 or self.compute_sha256))
        self.start_btn.setEnabled(enabled)

    def _clear_all_files(self):
        self.file_list_widget.clear()
        self.file_rows.clear()
        self.file_paths.clear()
        self._update_start_button()
        self.statusBar().showMessage("Cleared all files")

    def _toggle_live_log(self, checked):
        self.log_text.setVisible(checked)

    def dragEnterEvent(self, event: QDragEnterEvent):
        if event.mimeData().hasUrls():
            event.acceptProposedAction()
        else:
            super().dragEnterEvent(event)

    def dropEvent(self, event: QDropEvent):
        urls = event.mimeData().urls()
        if not urls:
            return
        added_count = 0
        for url in urls:
            path = Path(url.toLocalFile())
            if path.exists():
                if path.is_file():
                    added_count += self._add_file(path)
                elif path.is_dir():
                    added_count += self._add_folder(path)
        if added_count > 0:
            self._update_start_button()
            self.statusBar().showMessage(f"Added {added_count} new file(s)", 3000)
        event.acceptProposedAction()

    def _add_file(self, file_path: Path) -> int:
        """Add a single file to the list if not already present."""
        str_path = str(file_path.resolve())
        if str_path in self.file_rows:
            return 0
        self.file_paths.append(file_path)
        row_widget = FileRowWidget(file_path, len(self.file_paths))
        row_widget.remove_requested.connect(self._remove_row)
        # Store for later updates
        self.file_rows[str_path] = row_widget
        # Insert into QListWidget
        item = QListWidgetItem()
        self.file_list_widget.addItem(item)
        item.setSizeHint(row_widget.sizeHint())
        self.file_list_widget.setItemWidget(item, row_widget)
        return 1

    def _add_folder(self, folder_path: Path) -> int:
        """Recursively add all files from folder."""
        added = 0
        for file_path in folder_path.rglob("*"):
            if file_path.is_file():
                added += self._add_file(file_path)
        return added

    def _remove_row(self, row_widget: FileRowWidget):
        """Remove a file row from the list."""
        path_str = str(row_widget.file_path.resolve())
        if path_str in self.file_rows:
            del self.file_rows[path_str]
        # Remove from file_paths list
        for i, p in enumerate(self.file_paths):
            if str(p.resolve()) == path_str:
                self.file_paths.pop(i)
                break
        # Remove from list widget
        for i in range(self.file_list_widget.count()):
            item = self.file_list_widget.item(i)
            if self.file_list_widget.itemWidget(item) == row_widget:
                self.file_list_widget.takeItem(i)
                break
        # Renumber remaining rows
        self._renumber_rows()
        self._update_start_button()
        self.statusBar().showMessage("File removed", 2000)

    def _renumber_rows(self):
        """Update the index numbers on all rows after removal."""
        for i in range(self.file_list_widget.count()):
            item = self.file_list_widget.item(i)
            widget = self.file_list_widget.itemWidget(item)
            if isinstance(widget, FileRowWidget):
                widget.index = i + 1
                widget.num_label.setText(f"{widget.index}.")

    def _start_hashing(self):
        if not self.file_paths or not self.output_path:
            return
        if not (self.compute_md5 or self.compute_sha256):
            QMessageBox.warning(self, "Warning", "Select at least one hash algorithm")
            return

        # Disable UI
        self.start_btn.setEnabled(False)
        self.cancel_btn.setEnabled(True)
        self.clear_all_btn.setEnabled(False)
        self.browse_out_btn.setEnabled(False)
        self.md5_cb.setEnabled(False)
        self.sha256_cb.setEnabled(False)
        self.file_list_widget.setAcceptDrops(False)

        # Clear any existing hashes in rows (but keep rows)
        for row in self.file_rows.values():
            row.set_hashes("", "")
            row.hashes_ready = False

        self.progress_bar.setValue(0)
        self.current_file_label.setText("Starting...")

        # Create worker with current file list
        self.worker = HashWorker(self.file_paths, self.compute_md5, self.compute_sha256)
        self.worker.file_started.connect(self._on_file_started)
        self.worker.file_progress.connect(self._on_progress)
        self.worker.file_result.connect(self._on_file_result)
        self.worker.file_error.connect(self._on_file_error)
        self.worker.finished.connect(self._on_finished)
        self.worker.cancelled.connect(self._on_cancelled)
        self.worker.start()

    def _cancel_hashing(self):
        if self.worker and self.worker.isRunning():
            self.worker.cancel()
            self.statusBar().showMessage("Cancelling...")

    def _on_file_started(self, path_str: str):
        # Highlight current row
        for i in range(self.file_list_widget.count()):
            item = self.file_list_widget.item(i)
            widget = self.file_list_widget.itemWidget(item)
            if str(widget.file_path.resolve()) == path_str:
                widget.setStyleSheet("background-color: #e0f0ff;")
            else:
                widget.setStyleSheet("")
        self.current_file_label.setText(f"Hashing: {Path(path_str).name}")

    def _on_progress(self, current: int, total: int):
        self.progress_bar.setMaximum(total)
        self.progress_bar.setValue(current)

    def _on_file_result(self, path_str: str, md5: str, sha256: str):
        row = self.file_rows.get(path_str)
        if row:
            row.set_hashes(md5, sha256)
            # Also log to live log if visible
            if self.live_log_toggle.isChecked():
                self.log_text.append(f"✅ {Path(path_str).name} - MD5: {md5} SHA256: {sha256}")
                self.log_text.moveCursor(QTextCursor.End)
        # Remove highlight
        for i in range(self.file_list_widget.count()):
            item = self.file_list_widget.item(i)
            widget = self.file_list_widget.itemWidget(item)
            if str(widget.file_path.resolve()) == path_str:
                widget.setStyleSheet("")
                break

    def _on_file_error(self, path_str: str, error_msg: str):
        row = self.file_rows.get(path_str)
        if row:
            row.set_hashes("ERROR", "ERROR")
        if self.live_log_toggle.isChecked():
            self.log_text.append(f"❌ {Path(path_str).name}: {error_msg}")
            self.log_text.moveCursor(QTextCursor.End)

    def _on_finished(self, total: int, error_count: int):
        self._reset_ui()
        # Write output file
        self._write_output_file(total, error_count)
        msg = f"Hashing completed. Processed {total} files, errors: {error_count}. Results saved to {self.output_path}"
        self.statusBar().showMessage(msg)
        QMessageBox.information(self, "Complete", msg)

    def _on_cancelled(self):
        self._reset_ui()
        self.statusBar().showMessage("Cancelled by user")
        if self.live_log_toggle.isChecked():
            self.log_text.append("⚠️ Operation cancelled")

    def _reset_ui(self):
        self.cancel_btn.setEnabled(False)
        self.start_btn.setEnabled(True)
        self.clear_all_btn.setEnabled(True)
        self.browse_out_btn.setEnabled(True)
        self.md5_cb.setEnabled(True)
        self.sha256_cb.setEnabled(True)
        self.file_list_widget.setAcceptDrops(True)
        self.current_file_label.setText("Ready")
        self.progress_bar.setValue(0)
        # Remove any row highlights
        for i in range(self.file_list_widget.count()):
            item = self.file_list_widget.item(i)
            widget = self.file_list_widget.itemWidget(item)
            widget.setStyleSheet("")

    def _write_output_file(self, total: int, error_count: int):
        if not self.output_path:
            return
        try:
            with open(self.output_path, 'w', encoding='utf-8') as f:
                for idx, file_path in enumerate(self.file_paths, start=1):
                    row = self.file_rows.get(str(file_path.resolve()))
                    md5_val = row.md5 if row and row.hashes_ready else "NOT COMPUTED"
                    sha256_val = row.sha256 if row and row.hashes_ready else "NOT COMPUTED"
                    f.write(f"FILE #{idx}\n")
                    f.write(f"FILENAME: {file_path.name}\n")
                    f.write(f"MD5: {md5_val}\n")
                    f.write(f"SHA256: {sha256_val}\n\n")
                f.write(f"Total files processed: {total}\n")
                if error_count > 0:
                    f.write(f"Errors: {error_count}\n")
        except Exception as e:
            QMessageBox.warning(self, "Write Error", f"Failed to write output file:\n{e}")


def main():
    app = QApplication(sys.argv)
    # Try to load a nicer font for icons (optional)
    # You could load Font Awesome if available, but we use emojis.
    window = HashKitWindow()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()